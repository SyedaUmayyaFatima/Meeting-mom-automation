    {
      "parameters": {
        "jsCode": "// Get calendar event and meeting ID\nconst calEvent = $('Google Calendar Trigger').first().json;\nconst meetingId = $('Save Meeting to Supabase').first().json.id;\nconst meetingTitle = calEvent.summary;\n\n// Extract attendees array from calendar event\nconst attendees = calEvent.attendees || [];\n\n// If no attendees, return empty indicator\nif (attendees.length === 0) {\n  return [{ \n    json: { \n      meeting_id: meetingId,\n      meeting_title: meetingTitle,\n      no_attendees: true \n    } \n  }];\n}\n\n// Map each attendee to a participant record\nreturn attendees.map(attendee => ({\n  json: {\n    meeting_id: meetingId,\n    meeting_title: meetingTitle,\n    agenda: calEvent.description || null,\n    participant_id: null, // will be set by Insert/Upsert Participants node\n    name: attendee.displayName || attendee.email.split('@')[0],\n    email: attendee.email,\n    attendance_status: 'scheduled',\n    checkin_token: `${Date.now()}_${Math.random().toString(36).substr(2, 9)}`\n  }\n}));"
      },
      "name": "Extract Attendees1",
      "type": "n8n-nodes-base.code",
      "position": [
