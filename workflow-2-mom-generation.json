    {
      "parameters": {
        "jsCode": "const botData = $input.item.json;\n\nconst transcriptUrl = \n  botData?.recordings?.[0]?.media_shortcuts?.transcript?.data?.download_url ||\n  botData?.recordings?.[0]?.transcript?.download_url ||\n  botData?.media_shortcuts?.transcript?.data?.download_url ||\n  botData?.transcript?.download_url ||\n  \"\";\n\nconst meeting_id = botData?.id || \"\";\n\nconsole.log(\"Bot ID:\", meeting_id);\nconsole.log(\"Transcript URL found:\", transcriptUrl ? \"YES\" : \"NO\");\n\nreturn [{\n  json: {\n    transcript_url: transcriptUrl,\n    meeting_id: meeting_id,\n    has_transcript: transcriptUrl !== \"\"\n  }\n}];"
      },
      "name": "Format Transcript",
      "type": "n8n-nodes-base.code",
      "position": [
        -3024,
        2272
      ],
      "id": "fd5c5784-a12b-4f1b-bbe5-d91c10780165",
      "typeVersion": 2
    },
    {
      "parameters": {
        "url": "={{ $json.transcript_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -2816,
        2192
      ],
      "id": "fb8ff3f6-e2ef-45b0-9d0a-38d25e0d657d",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nlet formattedLines = [];\n\nfor (const item of allItems) {\n  const segment = item.json;\n  const speaker = segment?.participant?.name \n               || segment?.speaker_name \n               || \"Unknown\";\n  const words = segment?.words || [];\n  const text = words.map(w => w.text || \"\").join(\" \").trim();\n  if (text) {\n    formattedLines.push(`${speaker}: ${text}`);\n  }\n}\n\nconst rawTranscript = formattedLines.join(\" | \");\nconst cleanTranscript = rawTranscript\n  .replace(/\\n/g, \" \")\n  .replace(/\\r/g, \" \")\n  .replace(/\\t/g, \" \")\n  .replace(/\"/g, \"'\")\n  .replace(/\\\\/g, \"\");\n\nreturn [{\n  json: {\n    formattedTranscript: cleanTranscript || \"No transcript available.\",\n    meeting_id: $('Format Transcript').item.json.meeting_id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2656,
        1920
      ],
      "id": "f5bdaa3d-0eb3-4391-8330-fda9eeb1dc58",
      "name": "Parse Transcript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Edit Fields').item.json.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"max_tokens\": 2000,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a professional meeting secretary. Generate Minutes of Meeting in HTML. Output raw HTML only.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ $('Parse Transcript').item.json.formattedTranscript }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "name": "Generate MoM with GPT-4",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -2384,
        1920
      ],
      "id": "69ba32f7-5be9-40f0-8b9e-4560778df643",
      "typeVersion": 4.4
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst meetingId = $('Format Transcript').item.json.meeting_id;\n\nlet momHtml = response.choices[0].message.content;\n\nmomHtml = momHtml\n  .replace(/^```html\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\nreturn [{\n  json: {\n    mom_html: momHtml,\n    meeting_id: meetingId\n  }\n}];"
      },
