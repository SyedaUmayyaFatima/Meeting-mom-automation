        "jsCode": "// Pull all participant rows from previous node\nconst participants = $input.all();\n\n// Grab mom_html and meeting title from earlier nodes — attach directly to each item\n// so Gmail never needs to reach back across the broken item chain\nconst momHtml = $('Extract MoM HTML').item.json.mom_html;\nconst meetingTitle = $('Get Meeting').item.json.title;\nconst meetingId = $('Get Meeting').item.json.id;\n\nif (!participants || participants.length === 0) {\n  // No participants — return a dummy item so workflow doesn't crash\n  return [{ json: { skip: true, email: null, name: null, mom_html: momHtml, meeting_title: meetingTitle } }];\n}\n\n// Return one self-contained item per participant\nreturn participants.map(p => ({\n  json: {\n    skip: false,\n    email: p.json.email,\n    name: p.json.name || 'Participant',\n    mom_html: momHtml,\n    meeting_title: meetingTitle,\n    meeting_id: meetingId\n  }\n}));"
      },
