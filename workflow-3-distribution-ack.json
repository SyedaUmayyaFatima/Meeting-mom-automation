    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO acknowledgments (meeting_id, participant_id, status, email_sent_at)\nVALUES ($1, $2, 'pending', NOW())\nON CONFLICT (meeting_id, participant_id) \nDO UPDATE SET \n  status = 'pending',\n  email_sent_at = NOW(),\n  ack_token = gen_random_uuid()::text\nRETURNING id, ack_token, meeting_id, participant_id, status, email_sent_at",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "=={{ $json.meeting_id }},={{ $json.participant_id }}"
        }
      },
