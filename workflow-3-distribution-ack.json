        "message": "=<div style='font-family:sans-serif;max-width:600px;margin:0 auto'>\n  <h2 style='color:#1e1b4b'>Minutes of Meeting</h2>\n  <p>Hi <strong>{{ $('Split per Participant').item.json.name }}</strong>,</p>\n  <p>The minutes for <strong>{{ $('Split per Participant').item.json.meeting_title }}</strong> held on {{ $('Split per Participant').item.json.meeting_date }} are now available.</p>\n  <div style='background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:20px;margin:20px 0'>\n    {{ $('Split per Participant').item.json.mom_html }}\n  </div>\n  <p>Please acknowledge receipt by clicking below:</p>\n  <a href='https://umayyafatima.app.n8n.cloud/webhook/5788fd2c-81cd-4720-93b5-03ae784197c5/ack/{{ $json.ack_token }}' style='display:inline-block;background:#4f46e5;color:white;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:bold;'>✅ I have read the MoM</a>\n  <p style='color:#94a3b8;font-size:12px;margin-top:20px'>If you have any corrections, please reply to this email.</p>\n  <p style='color:#94a3b8;font-size:12px'><em>This email was sent automatically via n8n</em></p>\n</div>",
