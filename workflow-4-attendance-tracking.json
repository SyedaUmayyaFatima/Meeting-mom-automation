    {
      "parameters": {
        "jsCode": "const parsed = $('Parse Event').first().json;\n\n// For done events, get all participants from Download Participants\nif (parsed.eventType === 'done') {\n  const participants = $input.all();\n  return participants.map(item => ({\n    json: {\n      event: parsed.event,\n      eventType: parsed.eventType,\n      participantName: item.json.name,\n      botId: parsed.botId,\n      joinTime: null,\n      leaveTime: null,\n      recordingId: parsed.recordingId\n    }\n  }));\n}\n\n// For join/leave events, participant name already in Parse Event\nreturn [{\n  json: {\n    event: parsed.event,\n    eventType: parsed.eventType,\n    participantName: parsed.participantName,\n    botId: parsed.botId,\n    joinTime: parsed.joinTime,\n    leaveTime: parsed.leaveTime,\n    recordingId: parsed.recordingId\n  }\n}];"
