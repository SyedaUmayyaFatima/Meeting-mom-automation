    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst events = response.results || [];\nconst botId = $('Parse Event').first().json.botId;\n\n// Get meeting_id from database\nconst participantMap = {};\n\nfor (const event of events) {\n  const name = event.participant?.name || 'Unknown';\n  const code = event.event?.code || '';\n  const timestamp = event.created_at || null;\n\n  if (!participantMap[name]) {\n    participantMap[name] = {\n      participantName: name,\n      joinTime: null,\n      leaveTime: null,\n      botId: botId,\n      attendanceStatus: 'absent'\n    };\n  }\n\n  if (code === 'join' || code === 'joined') {\n    participantMap[name].joinTime = timestamp;\n    participantMap[name].attendanceStatus = 'present';\n  }\n\n  if (code === 'leave' || code === 'left') {\n    participantMap[name].leaveTime = timestamp;\n  }\n}\n\nreturn Object.values(participantMap).map(p => ({ json: p }));"
      },
