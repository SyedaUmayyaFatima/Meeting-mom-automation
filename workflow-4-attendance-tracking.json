    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst event = body.event;\nconst data = body.data || {};\n\nlet eventType = null;\nlet botId = null;\nlet participantName = null;\nlet joinTime = null;\nlet leaveTime = null;\n\nbotId = data.bot?.id || body.bot_id || null;\n\n// Extract participant name from correct location\nif (event === \"participant_events.join\") {\n  eventType = \"join\";\n  participantName = data.participant?.name \n    || body.participant?.name \n    || data.name \n    || null;\n  joinTime = data.timestamp || data.joined_at || new Date().toISOString();\n\n} else if (event === \"participant_events.leave\") {\n  eventType = \"leave\";\n  participantName = data.participant?.name \n    || body.participant?.name \n    || data.name \n    || null;\n  leaveTime = data.timestamp || data.left_at || new Date().toISOString();\n\n} else if (event === \"bot.done\" || event === \"recording.done\" || event === \"participant_events.done\") {\n  eventType = \"done\";\n\n} else {\n  eventType = \"unknown\";\n}\n\nconst recordingId = data.recording?.id || body.recording?.id || null;\n\nreturn [{\n  json: {\n    event,\n    eventType,\n    participantName,\n    botId,\n    joinTime,\n    leaveTime,\n    recordingId,\n    rawData: body,\n    ts: new Date().toISOString()\n  }\n}];"
      },
