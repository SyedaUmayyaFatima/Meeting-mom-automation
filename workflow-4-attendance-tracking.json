        "query": "WITH matched AS (\n  SELECT id FROM participants\n  WHERE LOWER(name) = LOWER($1)\n  LIMIT 1\n),\ninserted AS (\n  INSERT INTO participants (id, name, email)\n  SELECT gen_random_uuid(), $1, LOWER(REPLACE($1, ' ', '.')) || '@gmail.com'\n  WHERE NOT EXISTS (SELECT 1 FROM matched)\n  RETURNING id\n),\nfinal_id AS (\n  SELECT id FROM matched\n  UNION ALL\n  SELECT id FROM inserted\n  LIMIT 1\n)\nINSERT INTO meeting_participants \n  (meeting_id, participant_id, attendance_status, join_time, name, email)\nSELECT\n  m.id,\n  f.id,\n  'present',\n  NOW(),\n  $1,\n  (SELECT email FROM participants WHERE id = f.id)\nFROM meetings m, final_id f\nWHERE m.recall_bot_id = $2\nON CONFLICT (meeting_id, participant_id) DO UPDATE SET\n  attendance_status = 'present',\n  join_time = COALESCE(meeting_participants.join_time, NOW());",
