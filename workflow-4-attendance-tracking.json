      "parameters": {
        "operation": "executeQuery",
        "query": "WITH new_participant AS (\n  INSERT INTO participants (id, name, email)\n  VALUES (\n    gen_random_uuid(),\n    '{{ $json.participantName }}',\n    LOWER(REPLACE('{{ $json.participantName }}', ' ', '')) || '@unknown.com'\n  )\n  ON CONFLICT (email) DO UPDATE\n    SET name = EXCLUDED.name\n  RETURNING id, name, email\n)\nINSERT INTO meeting_participants\n  (meeting_id, participant_id, attendance_status, join_time, name, email)\nSELECT\n  '{{ $json.meeting_id }}',\n  np.id,\n  'present',\n  NOW(),\n  np.name,\n  np.email\nFROM new_participant np\nON CONFLICT (meeting_id, participant_id) DO UPDATE SET\n  attendance_status = 'present',\n  join_time = COALESCE(meeting_participants.join_time, EXCLUDED.join_time)",
        "options": {}
