    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO meeting_participants (meeting_id, participant_id, attendance_status, join_time, name, email)\nSELECT\n  $1::uuid,\n  p.id,\n  'present',\n  CASE \n    WHEN $3 = '' OR $3 = 'undefined' OR $3 IS NULL\n    THEN NOW() \n    ELSE $3::timestamptz \n  END,\n  p.name,\n  p.email\nFROM participants p\nWHERE p.id = $2::uuid\nON CONFLICT (meeting_id, participant_id)\nDO UPDATE SET\n  attendance_status = 'present',\n  join_time = COALESCE(meeting_participants.join_time, EXCLUDED.join_time),\n  name = COALESCE(meeting_participants.name, EXCLUDED.name),\n  email = COALESCE(meeting_participants.email, EXCLUDED.email)",
        "options": {
