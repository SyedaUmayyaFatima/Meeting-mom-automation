    {
      "parameters": {
        "jsCode": "const botData = $input.first().json;\nconst prevData = $('Parse Event').first().json;\n\nconst recording = botData.recordings?.[0];\nconst mediaShortcuts = recording?.media_shortcuts;\n\nconst participantsUrl = \n  mediaShortcuts?.participant_events?.data?.participants_download_url ||\n  mediaShortcuts?.participant_events?.data?.participant_events_download_url ||\n  null;\n\nreturn [{\n  json: {\n    ...prevData,\n    participantsUrl,\n    eventType: participantsUrl ? 'fetch_needed' : 'skip'\n  }\n}];"
